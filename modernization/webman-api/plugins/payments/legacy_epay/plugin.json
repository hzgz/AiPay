{
  "code": "legacy_epay",
  "name": "易支付网关插件",
  "description": "用于接入易支付网关模式，统一维护网关地址、商户号与签名密钥。",
  "version": "0.1.3",
  "provider": "AiPay官方",
  "entry": "plugins/payments/legacy_epay/src/Plugin.php",
  "class": "Plugins\\Payments\\LegacyEpay\\Plugin",
  "capabilities": [
    "create_order",
    "query",
    "refund",
    "notify"
  ],
  "merchant_enabled": true,
  "channel_type": "epay",
  "supported_payment_types": [
    "alipay",
    "wxpay",
    "qqpay"
  ],
  "migrations": {
    "strategy": "versioned_sql",
    "releases": [
      {
        "version": "0.1.0",
        "files": [
          "001_create_config_table.sql"
        ],
        "notes": [
          "创建插件专属配置表，供统一后台配置表单使用。"
        ]
      },
      {
        "version": "0.1.2",
        "files": [
          "002_create_plugin_log_table.sql"
        ],
        "notes": [
          "新增插件专属审计日志表，便于后续通知与升级轨迹独立留档并支持清理审查。"
        ]
      },
      {
        "version": "0.1.3",
        "files": [
          "003_add_upgrade_note_to_log.sql"
        ],
        "notes": [
          "为插件日志表新增升级备注字段，便于升级后记录更完整的诊断上下文。"
        ]
      }
    ]
  },
  "upgrade": {
    "impact": "medium",
    "downtime": "brief_validation",
    "requires_disable_after_upgrade": true,
    "notes": [
      "该插件每次升级后都会回到停用状态，需重新检查配置、通知路由与测试结果后再恢复流量。",
      "升级仅触达插件专属数据表与运行时元数据，不会改动核心商户订单数据。"
    ],
    "checklist": [
      "请在升级窗口开始前确认必填插件配置项均已完善。",
      "升级后请检查升级记录与运行状态，完成一轮支付测试后再重新启用插件。"
    ],
    "changelog": [
      {
        "version": "0.1.2",
        "summary": "新增插件专属日志表，用于记录升级与回调诊断信息。",
        "breaking": false,
        "migration_files": [
          "002_create_plugin_log_table.sql"
        ],
        "notes": [
          "不会改动任何共享业务数据表。",
          "插件完成审计并卸载后，彻底清理流程可移除该日志表。"
        ]
      },
      {
        "version": "0.1.3",
        "summary": "为插件日志表新增升级备注字段，便于记录版本级诊断信息而不触碰共享订单数据。",
        "breaking": false,
        "migration_files": [
          "003_add_upgrade_note_to_log.sql"
        ],
        "notes": [
          "既有插件日志记录仍然有效，新字段默认保留为空。",
          "插件重新启用前仍需完成一轮人工校验。"
        ]
      }
    ],
    "rollback": {
      "supported": true,
      "mode": "backup_restore",
      "automatic": false,
      "requires_backup": true,
      "notes": [
        "当前阶段暂不提供自动化插件降级执行器。",
        "如需回滚，请先从备份恢复插件包、插件专属数据表与运行记录，再重新恢复流量。"
      ]
    }
  },
  "cleanup": {
    "safe": {
      "files": [
        "runtime/payment-plugins/legacy_epay"
      ],
      "tables": [
        "pay_plugin_legacy_epay_config"
      ],
      "notes": [
        "安全卸载仅清理插件专属配置、缓存、临时文件与已生成产物，前提是已完成审计。"
      ]
    },
    "purge": {
      "files": [
        "plugins/payments/legacy_epay"
      ],
      "tables": [
        "pay_plugin_legacy_epay_log"
      ],
      "notes": [
        "彻底清理属于延后维护动作，不能在普通卸载请求中自动执行。"
      ]
    },
    "retain": [
      "商户订单历史",
      "充值记录",
      "资金与余额日志",
      "结算记录",
      "回调与审计轨迹"
    ],
    "purge_requires_confirmation": true
  }
}
