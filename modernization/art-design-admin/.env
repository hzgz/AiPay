# General environment

# App version
VITE_VERSION = 3.0.2

# Dev server port
VITE_PORT = 8132

# Application base path
VITE_BASE_URL = /

# Permission mode: frontend or backend
VITE_ACCESS_MODE = backend

# Whether cross-domain requests should carry cookies
VITE_WITH_CREDENTIALS = false

# Whether route debug info is shown
VITE_OPEN_ROUTE_INFO = false

# Whether local audit/login bypass is allowed in development
VITE_ENABLE_LOCAL_AUDIT_BYPASS = false

# Whether demo/example route groups are exposed
VITE_ENABLE_DEMO_ROUTES = false

# Whether unfinished public auth flows are exposed
VITE_ENABLE_PUBLIC_AUTH_FLOWS = false

# Lock screen encryption key
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro
