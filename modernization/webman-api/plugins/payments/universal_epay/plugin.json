{
  "code": "universal_epay",
  "name": "通用易支付V1插件",
  "description": "用于统一管理易支付上游商户号的托管插件。",
  "version": "1.0.0",
  "provider": "AiPay 官方",
  "entry": "plugins/payments/universal_epay/src/Plugin.php",
  "class": "Plugins\\Payments\\UniversalEpay\\Plugin",
  "capabilities": [
    "admin_account",
    "create_order",
    "query",
    "refund",
    "notify",
    "merchant_qrcode"
  ],
  "merchant_enabled": true,
  "supported_payment_types": [
    "alipay",
    "wxpay",
    "qqpay"
  ],
  "managed_channels": [
    {
      "code": "universal_epay",
      "name": "通用易支付V1插件",
      "type": "alipay",
      "info": "一个插件目录统一管理支付宝、微信、QQ 三种易支付上游账号。",
      "status": 1,
      "sort": 120,
      "maxcount": 999
    }
  ],
  "migrations": {
    "strategy": "versioned_sql",
    "releases": [
      {
        "version": "1.0.0",
        "files": [
          "001_create_config_table.sql",
          "002_create_plugin_log_table.sql"
        ],
        "notes": [
          "初始化通用易支付V1插件的配置表和日志表。",
          "将上游商户号、接口地址、商户密钥和接口模式统一放入共享账户字段。"
        ]
      }
    ]
  },
  "upgrade": {
    "impact": "low",
    "downtime": "none",
    "requires_disable_after_upgrade": false,
    "notes": [
      "该插件以一个托管账户模型统一处理支付宝、微信和 QQ 的易支付上游网关。",
      "下单、回调结算、查询和退款都在系统后端内完成。"
    ],
    "checklist": [
      "升级前确认没有未完成的清理计划。",
      "确认 admin_channel 仍保持 universal_epay 的托管模式。"
    ],
    "changelog": [
      {
        "version": "1.0.0",
        "summary": "通用易支付V1插件目录首版。",
        "breaking": false,
        "migration_files": [
          "001_create_config_table.sql",
          "002_create_plugin_log_table.sql"
        ],
        "notes": [
          "使用一个插件目录统一管理支付宝、微信和 QQ 易支付通道。",
          "共享账户字段映射为接口地址、商户编号、商户密钥和接口模式。"
        ]
      }
    ],
    "rollback": {
      "supported": true,
      "mode": "backup_restore",
      "automatic": false,
      "requires_backup": true,
      "notes": [
        "回滚前需要恢复插件目录和 pay_plugin_universal_epay_* 数据表。",
        "业务订单、商户、资金和结算数据不在插件清理范围内。"
      ]
    }
  },
  "cleanup": {
    "safe": {
      "files": [
        "runtime/payment-plugins/universal_epay"
      ],
      "tables": [
        "pay_plugin_universal_epay_config"
      ],
      "notes": [
        "安全清理只移除运行时文件和插件自有配置表。"
      ]
    },
    "purge": {
      "files": [
        "plugins/payments/universal_epay"
      ],
      "tables": [
        "pay_plugin_universal_epay_log"
      ],
      "notes": [
        "彻底清理会移除插件目录和日志表，并尝试同步清理托管通道。"
      ]
    },
    "retain": [
      "支付账户主记录",
      "历史订单",
      "资金和结算记录",
      "商户业务数据",
      "平台审计日志"
    ],
    "purge_requires_confirmation": true
  }
}
