# Production environment

# Static site base path, keep "/" unless you deploy under a sub-directory.
VITE_BASE_URL = /

# API prefix
VITE_API_URL = /api

# Remove console logs from the production bundle
VITE_DROP_CONSOLE = true

# Release hardening
VITE_ENABLE_LOCAL_AUDIT_BYPASS = false
VITE_ENABLE_DEMO_ROUTES = false
VITE_ENABLE_PUBLIC_AUTH_FLOWS = false
