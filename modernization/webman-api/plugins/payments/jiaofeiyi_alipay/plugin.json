{
  "code": "jiaofeiyi_alipay",
  "name": "缴费易支付宝插件",
  "description": "用于管理缴费易支付宝账户的托管插件。",
  "version": "1.0.0",
  "provider": "AiPay 官方",
  "entry": "plugins/payments/jiaofeiyi_alipay/src/Plugin.php",
  "class": "Plugins\\Payments\\JiaofeiyiAlipay\\Plugin",
  "capabilities": [
    "admin_account",
    "remote_gateway",
    "merchant_qrcode"
  ],
  "merchant_enabled": true,
  "supported_payment_types": [
    "alipay"
  ],
  "managed_channels": [
    {
      "code": "jiaofeiyi_alipay",
      "name": "缴费易支付宝",
      "type": "alipay",
      "info": "缴费易支付宝通道，由独立插件托管。",
      "status": 1,
      "sort": 100,
      "maxcount": 999
    }
  ],
  "migrations": {
    "strategy": "versioned_sql",
    "releases": [
      {
        "version": "1.0.0",
        "files": [
          "001_create_config_table.sql",
          "002_create_plugin_log_table.sql"
        ],
        "notes": [
          "初始化缴费易支付宝插件的配置表和日志表。",
          "沿用当前字段映射，并统一生命周期与清理元数据。"
        ]
      }
    ]
  },
  "upgrade": {
    "impact": "low",
    "downtime": "none",
    "requires_disable_after_upgrade": false,
    "notes": [
      "该插件当前聚焦于账户托管与统一下单接入。",
      "公共下单、远程兜底和查询逻辑已统一收口到后端。"
    ],
    "checklist": [
      "升级前确认没有未完成的清理计划。",
      "确认 admin_channel 仍保持 jiaofeiyi_alipay 的托管模式。"
    ],
    "changelog": [
      {
        "version": "1.0.0",
        "summary": "缴费易支付宝插件目录版本 1.0.0。",
        "breaking": false,
        "migration_files": [
          "001_create_config_table.sql",
          "002_create_plugin_log_table.sql"
        ],
        "notes": [
          "沿用商户ID、商户号、店铺名、备注和远程接口映射。",
          "缴费易请求逻辑已统一收口到后端共享支持层。"
        ]
      }
    ],
    "rollback": {
      "supported": true,
      "mode": "backup_restore",
      "automatic": false,
      "requires_backup": true,
      "notes": [
        "回滚前需要恢复插件目录和 pay_plugin_jiaofeiyi_alipay_* 数据表。",
        "业务订单、商户、资金和结算数据不在插件清理范围内。"
      ]
    }
  },
  "cleanup": {
    "safe": {
      "files": [
        "runtime/payment-plugins/jiaofeiyi_alipay"
      ],
      "tables": [
        "pay_plugin_jiaofeiyi_alipay_config"
      ],
      "notes": [
        "安全清理只移除运行时文件和插件自有配置表。"
      ]
    },
    "purge": {
      "files": [
        "plugins/payments/jiaofeiyi_alipay"
      ],
      "tables": [
        "pay_plugin_jiaofeiyi_alipay_log"
      ],
      "notes": [
        "彻底清理会移除插件目录和日志表，并尝试同步清理托管通道。"
      ]
    },
    "retain": [
      "支付账户主记录",
      "历史订单",
      "资金和结算记录",
      "商户业务数据",
      "平台审计日志"
    ],
    "purge_requires_confirmation": true
  }
}
