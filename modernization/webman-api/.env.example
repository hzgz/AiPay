APP_ENV=production
APP_DEBUG=false
# Webman backend process. Recommended to keep it behind Nginx and only expose 80/443.
APP_HOST=0.0.0.0
APP_PORT=8787
APP_WORKER_COUNT=1
APP_FILE_MONITOR=false
APP_MEMORY_MONITOR=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pay_v7
DB_USERNAME=pay_v7
DB_PASSWORD=change_me
DB_CHARSET=utf8
DB_COLLATION=utf8_general_ci

# Frontend shell base URL. Public home, merchant SPA, and admin SPA share the same host.
AIPAY_ADMIN_FRONTEND_URL=https://portal.example.com
AIPAY_MERCHANT_FRONTEND_URL=https://portal.example.com
AIPAY_PUBLIC_FRONTEND_URL=https://portal.example.com
