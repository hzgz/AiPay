{
  "code": "alipay_bill",
  "name": "支付宝二维码账单插件",
  "description": "用于维护支付宝二维码账单账户，统一管理配置、安装、启停与清理。",
  "version": "1.0.0",
  "provider": "AiPay 官方",
  "entry": "plugins/payments/alipay_bill/src/Plugin.php",
  "class": "Plugins\\Payments\\AlipayBill\\Plugin",
  "capabilities": [
    "admin_account",
    "bill_qrcode",
    "merchant_qrcode"
  ],
  "merchant_enabled": true,
  "managed_channels": [
    {
      "code": "alipay_bill",
      "name": "支付宝二维码账单插件",
      "type": "alipay",
      "info": "支付宝二维码账单通道，由独立支付插件托管。",
      "status": 1,
      "sort": 60,
      "maxcount": 999
    }
  ],
  "migrations": {
    "strategy": "versioned_sql",
    "releases": [
      {
        "version": "1.0.0",
        "files": [
          "001_create_config_table.sql",
          "002_create_plugin_log_table.sql"
        ],
        "notes": [
          "初始化支付宝二维码账单插件的配置表与日志表。",
          "沿用账单二维码字段处理逻辑，并统一插件生命周期与托管通道管理。"
        ]
      }
    ]
  },
  "upgrade": {
    "impact": "low",
    "downtime": "none",
    "requires_disable_after_upgrade": false,
    "notes": [
      "该插件主要管理后台账户能力与托管通道，不承接商户上游插件流量。",
      "后续若扩展二维码账单配置，应通过新增版本完成。"
    ],
    "checklist": [
      "升级前确认后台不存在未审核的插件清理计划。",
      "升级后检查 admin_channel 中 alipay_bill 通道仍处于插件托管状态。"
    ],
    "changelog": [
      {
        "version": "1.0.0",
        "summary": "支付宝二维码账单插件目录版本 1.0.0。",
        "breaking": false,
        "migration_files": [
          "001_create_config_table.sql",
          "002_create_plugin_log_table.sql"
        ],
        "notes": [
          "沿用账单二维码账户字段与票据组合逻辑。",
          "当前版本完成插件目录、清理策略与托管通道的独立管理。"
        ]
      }
    ],
    "rollback": {
      "supported": true,
      "mode": "backup_restore",
      "automatic": false,
      "requires_backup": true,
      "notes": [
        "如需回滚，请先恢复插件目录与 pay_plugin_alipay_bill_* 表。",
        "业务订单、商户、资金与结算数据不属于插件清理范围。"
      ]
    }
  },
  "cleanup": {
    "safe": {
      "files": [
        "runtime/payment-plugins/alipay_bill"
      ],
      "tables": [
        "pay_plugin_alipay_bill_config"
      ],
      "notes": [
        "安全清理仅移除插件运行时目录与插件自有配置表。"
      ]
    },
    "purge": {
      "files": [
        "plugins/payments/alipay_bill"
      ],
      "tables": [
        "pay_plugin_alipay_bill_log"
      ],
      "notes": [
        "彻底清理会移除插件包目录与插件日志表，并尝试清理插件托管通道。"
      ]
    },
    "retain": [
      "支付账户主表记录",
      "历史订单",
      "资金与结算记录",
      "商户业务数据",
      "平台审计日志"
    ],
    "purge_requires_confirmation": true
  }
}
